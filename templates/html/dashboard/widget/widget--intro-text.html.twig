{% autoescape false %}
    {% set strongOpen = '<strong>' %}
    {% set strongClose = '</strong>' %}
    <p class="mb-3">
        {% set numberOfDaysAgo = strongOpen ~ intro.getTotalDaysSinceFirstActivity() ~ strongClose %}
        {% set startDate = strongOpen ~ intro.getStartDate()|formatDate('normal') ~ strongClose %}
        {% set totalDaysOfWorkingOut = strongOpen ~ intro.getTotalDaysOfWorkingOut() ~ strongClose %}
        {% trans with {'{numberOfDaysAgo}': numberOfDaysAgo, '{startDate}': startDate, '{totalDaysOfWorkingOut}': totalDaysOfWorkingOut} %}
            Since I began using Strava {numberOfDaysAgo} ago on {startDate}, I've logged {totalDaysOfWorkingOut} active days of training and adventure.
        {% endtrans %}
    </p>
    <p class="mb-3">
        {% set convertedIntroDistance = intro.getDistance()|convertMeasurement %}
        {% set convertedIntroElevation = intro.getElevation()|convertMeasurement %}
        {% set totalDistance = strongOpen ~ convertedIntroDistance.toFloat()|formatNumber(0) ~ ' ' ~ convertedIntroDistance.getSymbol() ~ strongClose %}
        {% set numberOfTripsAroundTheWorld = strongOpen ~ (intro.getDistance().toFloat() / 40075)|formatNumber(2) ~ strongClose %}
        {% set numberOfTripsToTheMoonPercent = strongOpen ~ (intro.getDistance().toFloat() / 384400 * 100)|formatNumber(1) ~ strongClose %}
        {% set totalElevation = strongOpen ~ convertedIntroElevation.toFloat()|formatNumber(0) ~ ' ' ~ convertedIntroElevation.getSymbol() ~ strongClose %}
        {% set timesMountEverest = strongOpen ~ (intro.getElevation().toFloat() / 8849)|formatNumber(1) ~ strongClose %}
        {% set totalTimeRecorded = strongOpen ~ intro.getMovingTimeFormatted() ~ strongClose %}
        {% trans with {
            '{totalDistance}': totalDistance,
            '{numberOfTripsAroundTheWorld}': numberOfTripsAroundTheWorld,
            '{numberOfTripsToTheMoonPercent}': numberOfTripsToTheMoonPercent,
            '{totalElevation}': totalElevation,
            '{timesMountEverest}': timesMountEverest,
            '{totalTimeRecorded}': totalTimeRecorded
        } %}
            In that time, I've covered {totalDistance}, that's {numberOfTripsAroundTheWorld} trips around the world 🌍 or {numberOfTripsToTheMoonPercent}% of the way to the moon 🌕, and climbed an elevation of {totalElevation} which is {timesMountEverest} times Mount Everest 🏔. All up that's {totalTimeRecorded} of moving time 🎉.
        {% endtrans %}
    </p>
    <p class="mb-3">
        {% set convertedDailyAverage = intro.getDailyAverage()|convertMeasurement %}
        {% set convertedWeeklyAverage = intro.getWeeklyAverage()|convertMeasurement %}
        {% set convertedMonthlyAverage = intro.getMonthlyAverage()|convertMeasurement %}
        {% set dailyAverage = strongOpen ~ convertedDailyAverage.toFloat()|formatNumber(0) ~ ' ' ~ convertedDailyAverage.getSymbol() ~ strongClose %}
        {% set weeklyAverage = strongOpen ~ convertedWeeklyAverage.toFloat()|formatNumber(0) ~ ' ' ~ convertedWeeklyAverage.getSymbol() ~ strongClose %}
        {% set monthlyAverage = strongOpen ~ convertedMonthlyAverage.toFloat()|formatNumber(0) ~ ' ' ~ convertedMonthlyAverage.getSymbol() ~ strongClose %}
        {% trans with {'{dailyAverage}': dailyAverage, '{weeklyAverage}': weeklyAverage, '{monthlyAverage}': monthlyAverage} %}
            On average, that works out to {dailyAverage} per day, a weekly average of {weeklyAverage} and a monthly average of {monthlyAverage} 🐣.
        {% endtrans %}
    </p>
    <p>
        {% set caloriesBurned = strongOpen ~ intro.getCalories()|formatNumber(0) ~ strongClose %}
        {% set numberOfPizzaSlices = strongOpen ~ (intro.getCalories() / 270)|formatNumber(0) ~ strongClose %}
        {% trans with {'{caloriesBurned}': caloriesBurned, '{numberOfPizzaSlices}': numberOfPizzaSlices} %}
            Powered by an estimated {caloriesBurned} calories, or roughly {numberOfPizzaSlices} slices of pizza 🍕.
        {% endtrans %}
    </p>
{% endautoescape %}
