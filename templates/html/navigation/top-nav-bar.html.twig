<script>
var _importPoller = null;

function triggerStravaImport() {
    const btn = document.getElementById('triggerImportBtn');
    const icon = document.getElementById('triggerImportIcon');
    const label = document.getElementById('triggerImportLabel');

    btn.disabled = true;
    icon.style.animation = 'spin 1s linear infinite';
    icon.style.transformOrigin = 'center';
    label.textContent = '{{ "Syncing..."|trans }}';

    fetch('/trigger-import', {method: 'POST'})
        .then(() => { _importPoller = setInterval(_pollImportStatus, 2000); })
        .catch(() => {
            label.textContent = '{{ "Error"|trans }}';
            icon.style.animation = '';
            setTimeout(() => { label.textContent = '{{ "Sync Strava"|trans }}'; btn.disabled = false; }, 3000);
        });
}

function _pollImportStatus() {
    const btn = document.getElementById('triggerImportBtn');
    const icon = document.getElementById('triggerImportIcon');
    const label = document.getElementById('triggerImportLabel');

    fetch('/import-status')
        .then(r => r.json())
        .then(data => {
            if (data.line && data.line.length > 0) {
                const short = data.line.length > 45 ? data.line.substring(0, 45) + '…' : data.line;
                label.textContent = short;
            } else {
                label.textContent = '{{ "Syncing..."|trans }}';
            }
            if (!data.running) {
                clearInterval(_importPoller);
                _importPoller = null;
                icon.style.animation = '';
                label.textContent = '{{ "Import started!"|trans }}';
                setTimeout(() => { label.textContent = '{{ "Sync Strava"|trans }}'; btn.disabled = false; }, 3000);
            }
        })
        .catch(() => {
            clearInterval(_importPoller);
            _importPoller = null;
            icon.style.animation = '';
            label.textContent = '{{ "Sync Strava"|trans }}';
            btn.disabled = false;
        });
}
</script>
<style>
@keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
</style>